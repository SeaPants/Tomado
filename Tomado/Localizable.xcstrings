    "tooltip.timerPreset" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🐇 Short Focus (12+3): for varied tasks, admin, learning new domains, recovery from fatigue.\n🐢 Deep Focus (35+10): for deep work — writing, coding, complex reading, when in flow.\n⌘⇧T to toggle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🐇 ショートフォーカス (12+3): 雑多なタスク、事務作業、新しい分野の学習、疲労回復に。\n🐢 ディープフォーカス (35+10): 深い集中が必要な作業 — 執筆、コーディング、読解、フロー状態の維持に。\n⌘⇧T で切替。"
          }
        }
      }
    },
