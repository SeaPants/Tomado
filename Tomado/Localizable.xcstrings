    "tooltip.timetable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timetable mode (⌘⇧K): phases follow the wall clock instead of when you press play.\nEach period is split into equal sessions — 🐢 coarse, 🐇 twice as fine (Short×2 = Long)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間割モード (⌘⇧K): 押した時刻ではなく絶対時刻でフェーズが決まります。\n1 時限を均等なセッションに分割 — 🐢 は粗く、🐇 はその倍細かく（Short×2 = Long）。"
          }
        }
      }
    },
